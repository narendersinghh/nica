# Copy to .env and adjust. Never commit .env.

APP_NAME="The NiCa Collection"
# local | staging | production
APP_ENV=production
APP_DEBUG=false
# 64 hex chars. Generate with: php bin/console key:generate
APP_KEY=
APP_TIMEZONE=UTC

# Hosts this app answers to (comma separated). The site URL is built from the
# request's Host header, but only if it matches one of these. Wildcards:
# "*.example.com" matches any subdomain. Leave empty only in local.
TRUSTED_HOSTS=
# Set when behind a CDN/reverse proxy that sets X-Forwarded-Proto (e.g. Hostinger hcdn, Cloudflare).
# Comma separated proxy IPs, or "*" to trust any upstream.
TRUSTED_PROXIES=
# Optional: force a scheme ("https") when detection is unreliable.
FORCE_SCHEME=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nica
DB_USERNAME=nica
DB_PASSWORD=

SESSION_LIFETIME_MINUTES=120
SESSION_ABSOLUTE_HOURS=24

# Mail: "log" writes emails to storage/mail/ (local); "smtp" sends.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Stripe (Phase 3). Use test keys locally.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Importer only: a COPY of the WordPress database (never the live one).
# Leave host/username/password empty to reuse the DB_* login.
WP_DB_DATABASE=nica_wp
WP_DB_PREFIX=wp_
WP_DB_HOST=
WP_DB_USERNAME=
WP_DB_PASSWORD=

# Admin → Updates: where new versions come from (see DEPLOY.md → Updates).
UPDATE_REPOSITORY=narendersinghh/nica
UPDATE_BRANCH=main
# Only for a private repository: fine-grained token, read-only "Contents".
UPDATE_GITHUB_TOKEN=

# Integrations that need a server secret (all optional, off when empty)
META_CAPI_TOKEN=
