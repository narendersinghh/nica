# Apache / LiteSpeed (Hostinger). Document root must point at this public/ folder.

Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles (.env, .git, ...) except .well-known
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Everything that is not a real file goes to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    # Fingerprinted assets (?v=hash) can be cached for a year
    <FilesMatch "\.(css|js|woff2|webp|avif|jpg|jpeg|png|svg|ico|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
